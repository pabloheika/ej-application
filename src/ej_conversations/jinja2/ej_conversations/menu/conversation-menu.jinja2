{% from 'ej/includes/menu-item.jinja2' import menu_item %}

<nav class="participant-menu">
    <div class="page-menu__links grid-column-2">
        <a href="{{ url('profile:home') }}">
            <i class="fa fa-chevron-circle-up"></i>
            {{ _('Home') }}
        </a>
    </div>

    <span class="participant-menu__conversation-text grid-column-2">{{conversation.text}}</span>
    <div class="grid-column-2">
        <h3 class="menu-section__title">{{_("About the conversation")}}</h3>
        <div class="participant-menu__conversation-info">
            <i class="fas fa-users"></i>
            <span>{{conversation.n_participants}} {{_("participants")}}</span>
        </div>
        <div class="participant-menu__conversation-info">
            <i class="fas fa-vote-yea"></i>
            <span>{{conversation.n_votes}} {{_("votes")}}</span>
        </div>
        <div class="participant-menu__conversation-share" onclick="copyToClipboard()">
            <i class="fas fa-share-alt"></i>
            <span>{{_("Share")}}</span>
        </div>
    </div>

    <div class="participant-menu__user-section grid-column-2">
        <img class="participant-menu__avatar" src="{{ request.user.profile.image_url }}">
        <span class="participant-menu__username">{{_("created by")}} {{ request.user.name }}</span>
    </div>

    {% include 'ej_conversations/menu/commom-sections.jinja2' %}
</nav>
