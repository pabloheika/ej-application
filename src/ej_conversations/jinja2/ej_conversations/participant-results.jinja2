{% from "ej_conversations/includes/results-comments-macro.jinja2" import show_comments_results %}
{% from "ej_conversations/includes/results-progress-macro.jinja2" import show_progress %}

<div class="collapse-section">
    <h1 class="text-accent">{{_("Find out")}}</h1>
    <img id="results-icon" class="collapse-section__icon" 
        src="/static/img/icons/chevron-double-up.svg"
    >
</div>

<div class="results results--hidden">
    {% if not has_minimum_comments %}
        <p>{{_("Insufficient data to view results")}}</p>

    {% elif not has_minimum_participant_votes %}
        <p>{{_("Keep participating to see the results")}}</p>

    {% else %}
        {% include 'ej_conversations/includes/results-scatter-cloud.jinja2' %}
</div>
{% endif %}

<script>
    $(".collapse-section").click(function() {
        $(".results").toggleClass("results--hidden");
        $("#results-icon").toggleClass("collapse-section__icon--clicked");
    });
</script>
