{% macro show_progress() %}
<div class="results__progress">
    <div class="results__progress-step results__progress-step--active" data-step="1"></div>
    <div class="results__progress-step" data-step="2"></div>
    <div class="results__progress-step" data-step="3"></div>
    <div class="results__progress-step" data-step="4"></div>
</div>
{% endmacro %}