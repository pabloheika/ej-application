<div id="users-detail-modal" class="cluster-modal modal__overlay">
    <div class="users-modal modal modal__container modal__container--text-align-unset modal__container--sm-height modal__container--lighter-bg modal--full-screen-mobile">
        <div class="cluster-modal__header user-detail__modal-header">
            <img src="{{ static('/img/icons/user-tag.svg') }}" alt="{{ _('User with tag') }}">
            <p>{{_("More informations")}}</p>
            <i onclick="closeUserModal()" class="fas fa-times"></i>
        </div>
        <div class="user-detail">
            <div class="user-detail__column">
                <div>
                    <span>{{_("Cluster")}}</span>
                    <p class="user-detail--lowercase">{{current_object["group"]}}</p>
                </div>
                <div>
                    <span>{{_("Date of participation in the conversation")}}</span>
                    <p>{{ conversation.user_participation_date.strftime('%d/%m/%Y') }}</p>
                </div>
                <div>
                    <span>{{_("Votes in the conversation")}}</span>
                    <p>{{conversation.n_user_votes}}</p>
                </div>
                <div>
                    <span>{{_("Comments in the conversation")}}</span>
                    <p>{{conversation.n_user_total_comments}}</p>
                </div>
            </div>

            <hr class="user-detail__divider">

            <div class="user-detail__column">
                <div>
                    <span>{{_("Full name")}}</span>
                    <p>{{ user.name }}</p>
                </div>
                <div>
                    <span>{{_("Birth date")}}</span>
                    {% if user.get_profile().birth_date %}
                        <p>{{ user.get_profile().birth_date }}</p>
                    {% else %}
                        <p></p>
                    {% endif %}
                </div>
                <div>
                    <span>{{_("E-mail")}}</span>
                    <p class="user-detail__email">{{ user.email }}</p>
                </div>
                <div>
                    <span>{{_("City")}}</span>
                    {% if user.get_profile().city %}
                        <p>{{ user.get_profile().city }}</p>
                    {% else %}
                        <p></p>
                    {% endif %}
                </div>
            </div>
        </div>
        <div class="user-detail__buttons">
            {% if previous %}
                <a class="user-detail__buttons-link"
                    id="previous-{{current_index-1}}"
                    hx-post="{{ url('boards:dataviz-users-modal', **conversation.get_url_kwargs()) }}"
                    hx-target="#users-detail-modal"
                    hx-vals='{"objects": {{objects}}, "user_email": "{{previous}}", "current_index": {{current_index-1}}}'
                    hx-trigger="click delay:0.5s">
                    {{csrf_input}}
                    <i class="fas fa-chevron-left"></i>
                    {{_("Previous")}}
                </a>
            {% endif %}
            {% if next %}
                <a class="user-detail__buttons-link user-detail__buttons-link--left"
                    id="next-{{current_index+1}}"
                    hx-post="{{ url('boards:dataviz-users-modal', **conversation.get_url_kwargs()) }}"
                    hx-target="#users-detail-modal"
                    hx-vals='{"objects": {{objects}}, "user_email": "{{next}}", "current_index": {{current_index+1}}}'
                    hx-trigger="click delay:0.5s">
                    {{csrf_input}}
                    {{_("Next")}}
                    <i class="fas fa-chevron-right"></i>
                </a>
            {% endif %}
        </div>
    </div>
</div>

<script>
    function closeUserModal() {
        const modal = $('#users-detail-modal');
        const body = $("body").removeClass('modal--hide-overflow-y');
        modalContainer = modal.find('.modal__container--sm-height');
        modalContainer.removeClass('modal__container--sm-height-transition');
        modal.addClass('hide');
    }

    $(".user-detail__buttons-link").click(function(){
        $(".users-modal").fadeOut(200);
        $(".users-modal").fadeIn(200);
    });

</script>